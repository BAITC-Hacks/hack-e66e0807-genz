# Copy to .env (which must remain ignored by git) and set your own OpenRouter key.
# The product sends report-derived tool results to OpenRouter only when this key is present.
OPENROUTER_API_KEY=

# Optional explicit off switch. Without a key, the assistant is disabled.
# ASSISTANT_ENABLED=0

# For Vite development proxy only (the normal built app is same-origin):
# ASSISTANT_DEV_ORIGIN=http://127.0.0.1:8000
